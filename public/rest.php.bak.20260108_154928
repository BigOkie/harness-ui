  <script>
    (function () {
      const selProfile = document.getElementById('profile');
      const selAuth = document.getElementById('auth');

      const basicFields = document.getElementById('basic_fields');
      const hmacFields = document.getElementById('hmac_fields');

      const basicUser = document.getElementById('basic_user');
      const basicPass = document.getElementById('basic_pass');

      const hmacUser = document.getElementById('hmac_user');
      const hmacSecret = document.getElementById('hmac_secret');

      function applyAuthVisibility() {
        const mode = selAuth.value || 'basic';
        if (mode === 'hmac') {
          basicFields.classList.add('hidden');
          hmacFields.classList.remove('hidden');
        } else {
          hmacFields.classList.add('hidden');
          basicFields.classList.remove('hidden');
        }
      }

      function populateFromProfile() {
        const opt = selProfile.options[selProfile.selectedIndex];
        if (!opt) return;

        const mode = selAuth.value || 'basic';

        // Always allow profile selection to populate BOTH sets so user can switch modes after selecting.
        const u = opt.getAttribute('data-u') || '';
        const p = opt.getAttribute('data-p') || '';
        const hu = opt.getAttribute('data-hmac-u') || '';
        const hs = opt.getAttribute('data-hmac-s') || '';

        if (u) basicUser.value = u;
        if (p) basicPass.value = p;

        if (hu) hmacUser.value = hu;
        if (hs) hmacSecret.value = hs;

        // If user picked HMAC and profile has HMAC creds, great.
        // If not, fields remain whatever user typed.
      }

      selAuth.addEventListener('change', () => {
        applyAuthVisibility();
        populateFromProfile();
      });

      selProfile.addEventListener('change', () => {
        populateFromProfile();
      });

      applyAuthVisibility();
    })();
  </script>
