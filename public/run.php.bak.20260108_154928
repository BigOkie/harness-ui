<?php
declare(strict_types=1);

session_start();
$config = require '/srv/harness-ui/bootstrap.php';

function harnessui_resolve_env_url(array $envs, string $selected): ?string
{
    $selected = trim($selected);
    if ($selected === '') return null;

    if (isset($envs[$selected]) && is_string($envs[$selected])) {
        return $envs[$selected];
    }

    if (str_contains($selected, '::')) {
        [$envKey, $locLabel] = explode('::', $selected, 2);
        if ($envKey !== '' && $locLabel !== '' && isset($envs[$envKey]) && is_array($envs[$envKey])) {
            $v = $envs[$envKey];
            if (isset($v[$locLabel]) && is_string($v[$locLabel])) {
                return $v[$locLabel];
            }
        }
    }

    return null;
}

function fail(int $code, string $msg): void {
    http_response_code($code);
    header('Content-Type: text/plain');
    echo $msg . "\n";
    exit;
}

if (($_POST['csrf'] ?? '') !== ($_SESSION['csrf'] ?? '')) {
    fail(403, 'CSRF failed');
}

$env = (string)($_POST['env'] ?? '');
$user = trim((string)($_POST['username'] ?? ''));
$pass = (string)($_POST['password'] ?? '');

if ($env === '' || $user === '' || $pass === '') {
    fail(400, 'Missing required fields');
}

$envs = $config['envs'] ?? [];
$url = harnessui_resolve_env_url($envs, $env);
if ($url === null) {
    fail(400, 'Invalid env');
}

$wsDir = (string)($config['ws_harness_dir'] ?? '');
$php = (string)($config['php_bin'] ?? '/usr/bin/php');
$runsDir = (string)($config['runs_dir'] ?? '/srv/harness-ui/var/runs');
$maxSeconds = (int)($config['max_run_seconds'] ?? 300);

if ($wsDir === '' || !is_dir($wsDir)) {
    fail(500, 'WS harness dir not configured or missing');
}
if (!is_dir($runsDir)) {
    @mkdir($runsDir, 0775, true);
}

$runId = gmdate('YmdHis') . '_' . bin2hex(random_bytes(4));
$runPath = rtrim($runsDir, '/') . '/' . $runId;
@mkdir($runPath, 0775, true);

$stdoutFile = $runPath . '/stdout.log';
$stderrFile = $runPath . '/stderr.log';
$csvFile    = $runPath . '/ws_suite.csv';

$meta = [
    'runId' => $runId,
    'startedAtUtc' => gmdate('c'),
    'harness' => 'ws',
    'env' => $env,
    'url' => $url,
    'cwd' => $wsDir,
    'runner' => $wsDir . '/bin/run_ws_suite.php',
    'csvLog' => $csvFile,
];
file_put_contents($runPath . '/meta.json', json_encode($meta, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

$cmd = [
    $php,
    $wsDir . '/bin/run_ws_suite.php',
    '--url=' . $url,
    '--creds=' . ($user . ':' . $pass),
    '--csv-log=' . $csvFile,
    '--timeout=' . $maxSeconds,
];

$descriptors = [
    1 => ['file', $stdoutFile, 'w'],
    2 => ['file', $stderrFile, 'w'],
];

$proc = proc_open($cmd, $descriptors, $pipes, $wsDir);
if (!is_resource($proc)) {
    fail(500, 'Failed to start process');
}

$status = proc_get_status($proc);
$start = time();

while ($status['running']) {
    if ((time() - $start) > $maxSeconds) {
        proc_terminate($proc);
        break;
    }
    usleep(200000);
    $status = proc_get_status($proc);
}

$exitCode = proc_close($proc);

$meta['finishedAtUtc'] = gmdate('c');
$meta['exitCode'] = $exitCode;
file_put_contents($runPath . '/meta.json', json_encode($meta, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

header('Location: /runs.php?run=' . rawurlencode($runId));
exit;
