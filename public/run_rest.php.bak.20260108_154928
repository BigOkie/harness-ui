<?php
declare(strict_types=1);

session_start();
$config = require '/srv/harness-ui/bootstrap.php';

function harnessui_resolve_env_url(array $envs, string $selected): ?string
{
    $selected = trim($selected);
    if ($selected === '') return null;

    if (isset($envs[$selected]) && is_string($envs[$selected])) {
        return $envs[$selected];
    }

    if (str_contains($selected, '::')) {
        [$envKey, $locLabel] = explode('::', $selected, 2);
        if ($envKey !== '' && $locLabel !== '' && isset($envs[$envKey]) && is_array($envs[$envKey])) {
            $v = $envs[$envKey];
            if (isset($v[$locLabel]) && is_string($v[$locLabel])) {
                return $v[$locLabel];
            }
        }
    }

    return null;
}

function fail(int $code, string $msg): void {
    http_response_code($code);
    header('Content-Type: text/plain');
    echo $msg . "\n";
    exit;
}

if (($_POST['csrf'] ?? '') !== ($_SESSION['csrf'] ?? '')) {
    fail(403, 'CSRF failed');
}

$env      = (string)($_POST['env'] ?? '');
$auth     = strtolower((string)($_POST['auth'] ?? 'basic'));
$scenario = (string)($_POST['scenario'] ?? '');

$basicUser = (string)($_POST['basic_user'] ?? '');
$basicPass = (string)($_POST['basic_pass'] ?? '');

$hmacUser   = (string)($_POST['hmac_user'] ?? '');
$hmacSecret = (string)($_POST['hmac_secret'] ?? '');

if ($env === '' || $scenario === '') {
    fail(400, 'Missing required fields');
}
if (!in_array($auth, ['basic', 'hmac'], true)) {
    $auth = 'basic';
}

$envs = $config['rest_envs'] ?? ($config['envs'] ?? []);
$baseUrl = harnessui_resolve_env_url($envs, $env);
if ($baseUrl === null) {
    fail(400, 'Invalid env');
}

$restDir = (string)($config['rest_harness_dir'] ?? '');
$php = (string)($config['php_bin'] ?? '/usr/bin/php');
$runsDir = (string)($config['runs_dir'] ?? '/srv/harness-ui/var/runs');
$maxSeconds = (int)($config['max_run_seconds'] ?? 300);

if ($restDir === '' || !is_dir($restDir)) {
    fail(500, 'REST harness dir not configured or missing');
}
if (!is_dir($runsDir)) {
    @mkdir($runsDir, 0775, true);
}

$runId = gmdate('YmdHis') . '_' . bin2hex(random_bytes(4));
$runPath = rtrim($runsDir, '/') . '/' . $runId;
@mkdir($runPath, 0775, true);

$stdoutFile = $runPath . '/stdout.log';
$stderrFile = $runPath . '/stderr.log';
$csvFile    = $runPath . '/rest_results.csv';

$meta = [
    'runId' => $runId,
    'startedAtUtc' => gmdate('c'),
    'harness' => 'rest',
    'env' => $env,
    'url' => $baseUrl,
    'scenario' => $scenario,
    'auth' => $auth,
    'cwd' => $restDir,
    'runner' => $restDir . '/bin/run_rest_tests.php',
    'csvLog' => $csvFile,
];
file_put_contents($runPath . '/meta.json', json_encode($meta, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

$cmd = [
    $php,
    $restDir . '/bin/run_rest_tests.php',
    '--env=' . $env,            // runner uses env for display; baseUrl is resolved internally in runner config
    '--auth=' . $auth,
    '--scenario=scenarios/' . $scenario,
    '--csv-log=' . $csvFile,
];

if ($auth === 'basic') {
    if ($basicUser === '' || $basicPass === '') {
        fail(400, 'Basic auth selected but username/password missing');
    }
    $cmd[] = '--basic-user=' . $basicUser;
    $cmd[] = '--basic-password=' . $basicPass;
} else {
    if ($hmacUser === '' || $hmacSecret === '') {
        fail(400, 'HMAC auth selected but hmac username/secret missing');
    }
    // NOTE: rest-harness expects --hmac-user (not --hmac-username)
    $cmd[] = '--hmac-user=' . $hmacUser;
    $cmd[] = '--hmac-secret=' . $hmacSecret;
}

$descriptors = [
    1 => ['file', $stdoutFile, 'w'],
    2 => ['file', $stderrFile, 'w'],
];

$proc = proc_open($cmd, $descriptors, $pipes, $restDir);
if (!is_resource($proc)) {
    fail(500, 'Failed to start process');
}

$status = proc_get_status($proc);
$start = time();

while ($status['running']) {
    if ((time() - $start) > $maxSeconds) {
        proc_terminate($proc);
        break;
    }
    usleep(200000);
    $status = proc_get_status($proc);
}

$exitCode = proc_close($proc);

$meta['finishedAtUtc'] = gmdate('c');
$meta['exitCode'] = $exitCode;
file_put_contents($runPath . '/meta.json', json_encode($meta, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));

header('Location: /runs.php?run=' . rawurlencode($runId));
exit;
